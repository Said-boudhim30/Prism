<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|locale"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- System Default Music Player category so Android offers Prism as default audio app -->
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!-- Dedicated Default Audio Player intent filter (local content/file + streams) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/itunes" />
            </intent-filter>

            <!-- Dedicated Default Video Player intent filter (local content/file + streams) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/mp4" />
                <data android:mimeType="application/x-mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
            </intent-filter>

            <!-- Dedicated Default Photo Viewer intent filter -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Direct "Share to Prism" support for single or multiple media items and HTTPS stream URLs -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Dynamic App Icon Switcher Aliases (Classic default uses MainActivity) -->
        <activity-alias
            android:name=".MainActivityObsidian"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_prism_icon_obsidian"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_prism_icon_obsidian"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityCrystal"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_prism_icon_crystal"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_prism_icon_crystal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityEmerald"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_prism_icon_emerald"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_prism_icon_emerald"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_prism_icon_gold"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_prism_icon_gold"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Safe zero-permission FileProvider for EXIF-stripped photo sharing & trimmed ringtones -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/prism_file_paths" />
        </provider>

        <!-- Background Audio Foreground Service + System MediaSession (Bluetooth, Lock Screen, Car) -->
        <service
            android:name=".player.PrismPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".widget.PrismMediaWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.widget.ACTION_NEXT" />
                <action android:name="com.example.widget.ACTION_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prism_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrismExpressiveCardWidgetProvider"
            android:exported="true"
            android:label="@string/widget_hub_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.widget.ACTION_NEXT" />
                <action android:name="com.example.widget.ACTION_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prism_expressive_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrismVinylSquareWidgetProvider"
            android:exported="true"
            android:label="@string/widget_vinyl_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.widget.ACTION_NEXT" />
                <action android:name="com.example.widget.ACTION_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prism_vinyl_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrismQuranWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quran_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prism_quran_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrismAudioDeckWidgetProvider"
            android:exported="true"
            android:label="@string/widget_deck_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.widget.ACTION_NEXT" />
                <action android:name="com.example.widget.ACTION_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prism_audio_deck_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrismQuickStudioWidgetProvider"
            android:exported="true"
            android:label="@string/widget_studio_dock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prism_quick_studio_widget_info" />
        </receiver>

        <receiver
            android:name=".player.MediaNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.notif.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.notif.ACTION_NEXT" />
                <action android:name="com.example.notif.ACTION_PREV" />
                <action android:name="com.example.notif.ACTION_STOP" />
            </intent-filter>
        </receiver>

        <!-- Android Quick Settings Tile for 1-Tap Play/Pause & Prism Launch -->
        <service
            android:name=".player.PrismQuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_play"
            android:label="@string/quick_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Morning Quran / Nasheed Alarm Receiver -->
        <receiver
            android:name=".player.MorningAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.alarm.ACTION_MORNING_ALARM_TRIGGER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
