<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_dock_music"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_art_bg"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_shortcut_music"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_dock_videos"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_art_bg"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_shortcut_videos"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_dock_vault"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_art_bg"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_shortcut_vault"
        android:textColor="@color/widget_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_dock_wifi"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/widget_art_bg"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_shortcut_wifi"
        android:textColor="@color/widget_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
